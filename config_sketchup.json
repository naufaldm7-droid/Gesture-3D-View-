{
  "_catatan": "Profil SketchUp. Dipakai oleh tombol 'Gesture Control' di SketchUp (--config config_sketchup.json). Nilai yang tidak ditulis di sini memakai bawaan gesture_cad/config.py. Aksi 'su' = Sketchup.send_action lewat jembatan Ruby; 'key' = cadangan shortcut bawaan SketchUp bila jembatan belum tersambung.",

  "host": {"name": "sketchup", "label": "SketchUp", "bridge_port": 47820},

  "camera": {"index": 0, "width": 640, "height": 480, "fps": 30, "backend": "dshow", "fourcc": "MJPG", "mirror": true},

  "hand": {"dominant": "Right", "fallback_any": true},

  "pointer": {
    "mode": "relative",
    "gain_slow": 0.6,
    "gain_fast": 2.4,
    "lock_ms": 200,
    "unlock_dist": 0.009,
    "drag_threshold": 0.025,
    "longpress_ms": 800,
    "zone": [0.2, 0.25, 0.75, 0.68]
  },

  "output": {
    "_catatan": "SketchUp: tombol tengah = orbit, Shift + tombol tengah = pan (kebalikan AutoCAD)",
    "nav": {"orbit": [], "pan": ["SHIFT"]},
    "require_foreground": true,
    "target_processes": ["sketchup.exe"],
    "toggle_hotkey": "CTRL+ALT+G",
    "start_armed": true,
    "activate_autocad_on_start": false
  },

  "two_hand": {
    "_catatan": "Dua kepal = putar kamera, dua cubit = geser, rentang = zoom. camera_via_bridge = kamera digerakkan langsung lewat API Ruby (paling halus).",
    "camera_via_bridge": true,
    "camera_orbit_gain": 3.0,
    "camera_pan_gain": 1.5,
    "camera_zoom_gain": 1.0,
    "camera_invert_x": false,
    "camera_invert_y": false
  },

  "continuous": {
    "POINT": "pointer",
    "PINCH": "drag",
    "FIST": "orbit",
    "VICTORY": "pan",
    "THREE": "zoom",
    "OPEN": "idle"
  },

  "discrete": {
    "THUMB_UP":   {"label": "ENTER", "key": "ENTER"},
    "THUMB_DOWN": {"label": "UNDO",  "su": "editUndo:", "key": "CTRL+Z"},
    "ROCK":       {"label": "ESC",   "key": "ESC"},
    "SHAKA":      {"label": "MENU",  "internal": "open_menu"}
  },

  "voice": {
    "enabled": true,
    "model": "models/vosk-model-small-en-us-0.15",
    "listen_seconds": 12,
    "speak": true,
    "hotkey": "CTRL+ALT+V",
    "host_word": "sketchup",
    "wake": ["sketchup please help me", "sketchup are you ready", "hey sketchup", "hello sketchup", "sketchup help", "sketchup wake up"],
    "sleep": ["thank you", "thanks", "stop listening", "go to sleep", "that is all"],
    "fillers": ["please", "now", "the", "a", "an", "can", "you", "hey", "tool", "draw", "make", "start", "do", "use", "i", "want", "to"],
    "commands": [
      {"say": ["line"],                      "label": "LINE",       "su": "selectLineTool:",         "key": "L"},
      {"say": ["rectangle"],                 "label": "RECTANGLE",  "su": "selectRectangleTool:",    "key": "R"},
      {"say": ["circle"],                    "label": "CIRCLE",     "su": "selectCircleTool:",       "key": "C"},
      {"say": ["arc"],                       "label": "ARC",        "su": "selectArcTool:",          "key": "A"},
      {"say": ["polygon"],                   "label": "POLYGON",    "su": "selectPolygonTool:"},
      {"say": ["offset"],                    "label": "OFFSET",     "su": "selectOffsetTool:",       "key": "F"},
      {"say": ["pushpull", "extrude"],       "label": "PUSH/PULL",  "su": "selectPushPullTool:",     "key": "P"},
      {"say": ["followme"],                  "label": "FOLLOW ME",  "su": "selectExtrudeTool:"},
      {"say": ["move"],                      "label": "MOVE",       "su": "selectMoveTool:",         "key": "M"},
      {"say": ["rotate"],                    "label": "ROTATE",     "su": "selectRotateTool:",       "key": "Q"},
      {"say": ["scale"],                     "label": "SCALE",      "su": "selectScaleTool:",        "key": "S"},
      {"say": ["select"],                    "label": "SELECT",     "su": "selectSelectionTool:",    "key": "SPACE"},
      {"say": ["eraser", "erase"],           "label": "ERASER",     "su": "selectEraseTool:",        "key": "E"},
      {"say": ["paint"],                     "label": "PAINT",      "su": "selectPaintTool:",        "key": "B"},
      {"say": ["tape", "measure"],           "label": "TAPE",       "su": "selectMeasureTool:",      "key": "T"},
      {"say": ["dimension"],                 "label": "DIMENSION",  "su": "selectDimensionTool:"},
      {"say": ["text"],                      "label": "TEXT",       "su": "selectTextTool:"},
      {"say": ["copy"],                      "label": "COPY",       "su": "editCopy:",               "key": "CTRL+C"},
      {"say": ["paste"],                     "label": "PASTE",      "su": "editPaste:",              "key": "CTRL+V"},
      {"say": ["delete"],                    "label": "DELETE",     "su": "editDelete:",             "key": "DELETE"},
      {"say": ["select all"],                "label": "SELECT ALL", "su": "editSelectAll:",          "key": "CTRL+A"},
      {"say": ["make component", "component"], "label": "COMPONENT", "key": "G"},
      {"say": ["top view"],                  "label": "TOP",        "su": "viewTop:"},
      {"say": ["front view"],                "label": "FRONT",      "su": "viewFront:"},
      {"say": ["right view"],                "label": "RIGHT",      "su": "viewRight:"},
      {"say": ["iso view", "isometric"],     "label": "ISO",        "su": "viewIso:"},
      {"say": ["zoom extents", "zoom all", "fit view"], "label": "ZOOM EXT", "su": "viewZoomExtents:", "key": "SHIFT+Z"},
      {"say": ["orbit"],                     "label": "ORBIT",      "su": "selectOrbitTool:",        "key": "O"},
      {"say": ["pan"],                       "label": "PAN",        "su": "selectDollyTool:",        "key": "H"},
      {"say": ["xray"],                      "label": "X-RAY",      "su_xray": true},
      {"say": ["wireframe"],                 "label": "WIREFRAME",  "su_render": 0},
      {"say": ["shaded"],                    "label": "SHADED",     "su_render": 2},
      {"say": ["undo"],                      "label": "UNDO",       "su": "editUndo:",               "key": "CTRL+Z"},
      {"say": ["redo"],                      "label": "REDO",       "su": "editRedo:",               "key": "CTRL+Y"},
      {"say": ["enter", "okay", "done"],     "label": "ENTER",      "key": "ENTER"},
      {"say": ["escape", "cancel"],          "label": "ESC",        "key": "ESC"},
      {"say": ["save"],                      "label": "SAVE",       "key": "CTRL+S"},
      {"say": ["show menu", "menu"],         "label": "MENU",       "internal": "open_menu"},
      {"say": ["close menu"],                "label": "TUTUP MENU", "internal": "close_menu"},
      {"say": ["pause gesture"],             "label": "JEDA",       "internal": "toggle_arm"},
      {"say": ["close gesture", "exit gesture"], "label": "KELUAR", "internal": "quit"}
    ]
  },

  "menu": {
    "dwell_ms": 900,
    "columns": 4,
    "close_after_select": true,
    "pages": [
      {"name": "GAMBAR", "items": [
        {"label": "LINE",       "su": "selectLineTool:",      "key": "L"},
        {"label": "RECTANGLE",  "su": "selectRectangleTool:", "key": "R"},
        {"label": "CIRCLE",     "su": "selectCircleTool:",    "key": "C"},
        {"label": "ARC",        "su": "selectArcTool:",       "key": "A"},
        {"label": "POLYGON",    "su": "selectPolygonTool:"},
        {"label": "FREEHAND",   "su": "selectFreehandTool:"},
        {"label": "OFFSET",     "su": "selectOffsetTool:",    "key": "F"},
        {"label": "PUSH/PULL",  "su": "selectPushPullTool:",  "key": "P"},
        {"label": "FOLLOW ME",  "su": "selectExtrudeTool:"},
        {"label": "3D TEXT",    "su": "select3dTextTool:"},
        {"label": "PAINT",      "su": "selectPaintTool:",     "key": "B"},
        {"label": "ERASER",     "su": "selectEraseTool:",     "key": "E"}
      ]},
      {"name": "UBAH", "items": [
        {"label": "SELECT",     "su": "selectSelectionTool:", "key": "SPACE"},
        {"label": "MOVE",       "su": "selectMoveTool:",      "key": "M"},
        {"label": "ROTATE",     "su": "selectRotateTool:",    "key": "Q"},
        {"label": "SCALE",      "su": "selectScaleTool:",     "key": "S"},
        {"label": "COPY",       "su": "editCopy:",            "key": "CTRL+C"},
        {"label": "PASTE",      "su": "editPaste:",           "key": "CTRL+V"},
        {"label": "CUT",        "su": "editCut:",             "key": "CTRL+X"},
        {"label": "DELETE",     "su": "editDelete:",          "key": "DELETE"},
        {"label": "SELECT ALL", "su": "editSelectAll:",       "key": "CTRL+A"},
        {"label": "SELECT NONE","su": "editSelectNone:"},
        {"label": "HIDE",       "su": "editHide:"},
        {"label": "COMPONENT",  "key": "G"}
      ]},
      {"name": "UKUR", "items": [
        {"label": "TAPE",       "su": "selectMeasureTool:",   "key": "T"},
        {"label": "PROTRACTOR", "su": "selectProtractorTool:"},
        {"label": "DIMENSION",  "su": "selectDimensionTool:"},
        {"label": "TEXT",       "su": "selectTextTool:"},
        {"label": "AXES",       "su": "selectAxisTool:"},
        {"label": "SECTION",    "su": "selectSectionPlaneTool:"}
      ]},
      {"name": "KAMERA", "items": [
        {"label": "ISO",        "su": "viewIso:"},
        {"label": "TOP",        "su": "viewTop:"},
        {"label": "FRONT",      "su": "viewFront:"},
        {"label": "RIGHT",      "su": "viewRight:"},
        {"label": "BACK",       "su": "viewBack:"},
        {"label": "LEFT",       "su": "viewLeft:"},
        {"label": "BOTTOM",     "su": "viewBottom:"},
        {"label": "ZOOM EXT",   "su": "viewZoomExtents:",     "key": "SHIFT+Z"},
        {"label": "ZOOM SEL",   "su": "viewZoomToSelection:"},
        {"label": "PERSPECTIVE","su": "viewPerspective:"},
        {"label": "ORBIT",      "su": "selectOrbitTool:",     "key": "O"},
        {"label": "PAN",        "su": "selectDollyTool:",     "key": "H"},
        {"label": "ZOOM",       "su": "selectZoomTool:",      "key": "Z"},
        {"label": "WALK",       "su": "selectWalkTool:"}
      ]},
      {"name": "GAYA", "items": [
        {"label": "WIREFRAME",  "su_render": 0},
        {"label": "HIDDEN LINE","su_render": 1},
        {"label": "SHADED",     "su_render": 2},
        {"label": "TEXTURES",   "su_render": 3},
        {"label": "MONOCHROME", "su_render": 5},
        {"label": "X-RAY",      "su_xray": true}
      ]},
      {"name": "UMUM", "items": [
        {"label": "ENTER",      "key": "ENTER"},
        {"label": "ESC",        "key": "ESC"},
        {"label": "UNDO",       "su": "editUndo:",            "key": "CTRL+Z"},
        {"label": "REDO",       "su": "editRedo:",            "key": "CTRL+Y"},
        {"label": "SAVE",       "key": "CTRL+S"},
        {"label": "TAB BERIKUT","key": "CTRL+TAB"}
      ]}
    ]
  },

  "ui": {"style": "glass", "blur": true, "camera_card": true, "guide": true, "cursor_halo": true, "camera_width": 300,
         "quit_hotkey": "CTRL+ALT+Q", "guide_hotkey": "CTRL+ALT+H", "camera_hotkey": "CTRL+ALT+C"}
}
