{
  "_catatan": "Semua kunci yang diawali '_' diabaikan. Nilai yang dihapus kembali ke bawaan di gesture_cad/config.py. Cek perubahan dengan: python -m gesture_cad --check",

  "camera": {"index": "auto", "width": 640, "height": 480, "fps": 30, "backend": "dshow", "fourcc": "MJPG", "mirror": true},

  "hand": {"dominant": "Right", "fallback_any": true},

  "timing": {
    "_catatan": "stable_ms = berapa lama pose harus bertahan sebelum dianggap; hold_ms = tahan untuk perintah sekali-tembak",
    "stable_ms": {"default": 120, "PINCH": 40, "POINT": 70},
    "lost_grace_ms": 250,
    "hold_ms": 600,
    "arm_hold_ms": 1500,
    "menu_open_grace_ms": 600
  },

  "pointer": {
    "_catatan": "relative = seperti mouse (presisi). Kursor terlalu lambat -> naikkan gain_slow; terlalu licin -> turunkan gain_slow/gain_fast atau naikkan lock_ms. Klik susah -> naikkan pinch_on/pinch_off di thresholds.",
    "mode": "relative",
    "gain_slow": 0.6,
    "gain_fast": 2.4,
    "lock_ms": 200,
    "unlock_dist": 0.009,
    "drag_threshold": 0.025,
    "longpress_ms": 800,
    "zone": [0.2, 0.25, 0.75, 0.68]
  },

  "motion": {
    "_catatan": "gain = piksel layar per lebar penuh gambar kamera; accel_min/max = pengali saat gerak pelan/cepat",
    "deadzone": 0.004,
    "orbit_gain_px": 1100,
    "pan_gain_px": 1400,
    "accel_min": 0.5,
    "accel_max": 1.6,
    "zoom_step": 0.05,
    "zoom_invert": false
  },

  "output": {
    "require_foreground": true,
    "target_processes": ["acad.exe"],
    "toggle_hotkey": "CTRL+ALT+G",
    "start_armed": true,
    "activate_autocad_on_start": true
  },

  "ui": {
    "_catatan": "style glass = overlay kaca tembus-klik di atas AutoCAD; classic = jendela kamera lama",
    "style": "glass",
    "blur": true,
    "camera_card": true,
    "guide": true,
    "cursor_halo": true,
    "camera_width": 300,
    "quit_hotkey": "CTRL+ALT+Q",
    "guide_hotkey": "CTRL+ALT+H",
    "camera_hotkey": "CTRL+ALT+C"
  },

  "continuous": {
    "POINT": "pointer",
    "PINCH": "drag",
    "FIST": "orbit",
    "VICTORY": "pan",
    "THREE": "zoom",
    "OPEN": "idle"
  },

  "discrete": {
    "THUMB_UP":   {"label": "ENTER", "key": "ENTER"},
    "THUMB_DOWN": {"label": "UNDO",  "cmd": "_U"},
    "ROCK":       {"label": "ESC",   "key": "ESC"},
    "SHAKA":      {"label": "MENU",  "internal": "open_menu"}
  },

  "voice": {
    "_catatan": "Opsional, offline (Vosk, bahasa Inggris). Bangunkan dengan kata di 'wake', tidurkan dengan 'sleep'. Ctrl+Alt+V = suara on/off.",
    "enabled": true,
    "model": "models/vosk-model-small-en-us-0.15",
    "listen_seconds": 12,
    "speak": true,
    "hotkey": "CTRL+ALT+V",
    "wake": ["autocad please help me", "autocad are you ready", "hey autocad", "hello autocad", "autocad help", "autocad wake up"],
    "sleep": ["thank you", "thanks", "stop listening", "go to sleep", "that is all"],
    "fillers": ["please", "now", "the", "a", "an", "can", "you", "hey", "command", "draw", "make", "start", "do", "use", "run", "tool", "i", "want", "to"],
    "commands": [
      {"say": ["line"],                         "label": "LINE",        "cmd": "_LINE"},
      {"say": ["polyline"],                     "label": "POLYLINE",    "cmd": "_PLINE"},
      {"say": ["circle"],                       "label": "CIRCLE",      "cmd": "_CIRCLE"},
      {"say": ["arc"],                          "label": "ARC",         "cmd": "_ARC"},
      {"say": ["rectangle"],                    "label": "RECTANGLE",   "cmd": "_RECTANG"},
      {"say": ["polygon"],                      "label": "POLYGON",     "cmd": "_POLYGON"},
      {"say": ["offset"],                       "label": "OFFSET",      "cmd": "_OFFSET"},
      {"say": ["trim", "cut"],                  "label": "TRIM",        "cmd": "_TRIM"},
      {"say": ["extend"],                       "label": "EXTEND",      "cmd": "_EXTEND"},
      {"say": ["fillet"],                       "label": "FILLET",      "cmd": "_FILLET"},
      {"say": ["chamfer"],                      "label": "CHAMFER",     "cmd": "_CHAMFER"},
      {"say": ["move"],                         "label": "MOVE",        "cmd": "_MOVE"},
      {"say": ["copy"],                         "label": "COPY",        "cmd": "_COPY"},
      {"say": ["rotate"],                       "label": "ROTATE",      "cmd": "_ROTATE"},
      {"say": ["3d rotate"],                    "label": "3DROTATE",    "cmd": "_3DROTATE"},
      {"say": ["3d move"],                      "label": "3DMOVE",      "cmd": "_3DMOVE"},
      {"say": ["scale"],                        "label": "SCALE",       "cmd": "_SCALE"},
      {"say": ["mirror"],                       "label": "MIRROR",      "cmd": "_MIRROR"},
      {"say": ["erase", "delete"],              "label": "ERASE",       "cmd": "_ERASE"},
      {"say": ["explode"],                      "label": "EXPLODE",     "cmd": "_EXPLODE"},
      {"say": ["join"],                         "label": "JOIN",        "cmd": "_JOIN"},
      {"say": ["array"],                        "label": "ARRAY",       "cmd": "_ARRAY"},
      {"say": ["hatch"],                        "label": "HATCH",       "cmd": "_HATCH"},
      {"say": ["text"],                         "label": "TEXT",        "cmd": "_MTEXT"},
      {"say": ["dimension"],                    "label": "DIMENSION",   "cmd": "_DIMLINEAR"},
      {"say": ["box"],                          "label": "BOX",         "cmd": "_BOX"},
      {"say": ["cylinder"],                     "label": "CYLINDER",    "cmd": "_CYLINDER"},
      {"say": ["sphere"],                       "label": "SPHERE",      "cmd": "_SPHERE"},
      {"say": ["cone"],                         "label": "CONE",        "cmd": "_CONE"},
      {"say": ["wedge"],                        "label": "WEDGE",       "cmd": "_WEDGE"},
      {"say": ["torus"],                        "label": "TORUS",       "cmd": "_TORUS"},
      {"say": ["pyramid"],                      "label": "PYRAMID",     "cmd": "_PYRAMID"},
      {"say": ["extrude"],                      "label": "EXTRUDE",     "cmd": "_EXTRUDE"},
      {"say": ["presspull", "push pull"],       "label": "PRESSPULL",   "cmd": "_PRESSPULL"},
      {"say": ["revolve"],                      "label": "REVOLVE",     "cmd": "_REVOLVE"},
      {"say": ["sweep"],                        "label": "SWEEP",       "cmd": "_SWEEP"},
      {"say": ["loft"],                         "label": "LOFT",        "cmd": "_LOFT"},
      {"say": ["union", "combine"],             "label": "UNION",       "cmd": "_UNION"},
      {"say": ["subtract"],                     "label": "SUBTRACT",    "cmd": "_SUBTRACT"},
      {"say": ["intersect"],                    "label": "INTERSECT",   "cmd": "_INTERSECT"},
      {"say": ["slice"],                        "label": "SLICE",       "cmd": "_SLICE"},
      {"say": ["zoom extents", "zoom all", "fit view"], "label": "ZOOM EXT", "cmd": "_ZOOM _E"},
      {"say": ["zoom previous"],                "label": "ZOOM PREV",   "cmd": "_ZOOM _P"},
      {"say": ["top view"],                     "label": "TOP",         "cmd": "_-VIEW _TOP"},
      {"say": ["front view"],                   "label": "FRONT",       "cmd": "_-VIEW _FRONT"},
      {"say": ["right view"],                   "label": "RIGHT",       "cmd": "_-VIEW _RIGHT"},
      {"say": ["iso view", "isometric", "south west"], "label": "SW ISO", "cmd": "_-VIEW _SWISO"},
      {"say": ["orbit"],                        "label": "3DORBIT",     "cmd": "_3DORBIT"},
      {"say": ["conceptual"],                   "label": "CONCEPTUAL",  "cmd": "_VSCURRENT _Conceptual"},
      {"say": ["realistic"],                    "label": "REALISTIC",   "cmd": "_VSCURRENT _Realistic"},
      {"say": ["wireframe"],                    "label": "WIREFRAME",   "cmd": "_VSCURRENT _2dwireframe"},
      {"say": ["hidden"],                       "label": "HIDDEN",      "cmd": "_VSCURRENT _Hidden"},
      {"say": ["undo"],                         "label": "UNDO",        "cmd": "_U"},
      {"say": ["redo"],                         "label": "REDO",        "cmd": "_REDO"},
      {"say": ["enter", "okay", "done", "yes"], "label": "ENTER",       "key": "ENTER"},
      {"say": ["escape", "cancel"],             "label": "ESC",         "key": "ESC"},
      {"say": ["save"],                         "label": "SAVE",        "cmd": "_QSAVE"},
      {"say": ["ortho"],                        "label": "ORTHO",       "key": "F8"},
      {"say": ["snap", "object snap"],          "label": "OSNAP",       "key": "F3"},
      {"say": ["layer"],                        "label": "LAYER",       "cmd": "_LAYER"},
      {"say": ["properties"],                   "label": "PROPERTIES",  "key": "CTRL+1"},
      {"say": ["measure"],                      "label": "MEASURE",     "cmd": "_MEASUREGEOM"},
      {"say": ["select all"],                   "label": "SELECT ALL",  "key": "CTRL+A"},
      {"say": ["clean screen", "full screen"],  "label": "CLEAN SCREEN","key": "CTRL+0"},
      {"say": ["next drawing", "next tab"],     "label": "NEXT TAB",    "key": "CTRL+TAB"},
      {"say": ["show menu", "menu"],            "label": "MENU",        "internal": "open_menu"},
      {"say": ["close menu"],                   "label": "TUTUP MENU",  "internal": "close_menu"},
      {"say": ["pause gesture", "pause hands"], "label": "JEDA",        "internal": "toggle_arm"},
      {"say": ["close gesture", "exit gesture"],"label": "KELUAR",      "internal": "quit"}
    ]
  },

